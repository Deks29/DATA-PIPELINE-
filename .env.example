# SightSync Batch Pipeline - Stage 1: Data Extraction
#
# Standalone Polars extraction engine (see extraction/) orchestrated by an
# Apache Airflow DAG (see dags/). Run locally with:
#
#   python -m extraction.cli --business-date 2026-10-06
#
# openFDA REST API source (staging.device_classification)
# The client paginates this endpoint and registers the result snapshot as an
# extraction table. Optional: API_SEARCH, API_LIMIT, API_KEY.
API=https://api.fda.gov/device/classification.json
# API_SEARCH=product_code:NOB
# API_LIMIT=500
# API_KEY=

# Stage 2: Data Transformation (Polars analytics engine)
# Paths default to the project data/ layout. Override only when the
# transformation engine should read or write somewhere else.
# SIGHTSYNC_TRANSFORM_STAGING_DIR=
# SIGHTSYNC_TRANSFORM_OUTPUT_DIR=
# SIGHTSYNC_TRANSFORM_QUARANTINE_DIR=
# SIGHTSYNC_TRANSFORM_LOGS_DIR=
# SIGHTSYNC_TRANSFORM_METADATA_DB=
# SIGHTSYNC_TRANSFORM_LOOKBACK_DAYS=3
# SIGHTSYNC_TRANSFORM_REJECTED_RATIO_THRESHOLD=0.01
# SIGHTSYNC_TRANSFORM_MAX_REJECTED_RATIO_THRESHOLD=0.05
# SIGHTSYNC_TRANSFORM_ALLOW_LATEST_FALLBACK=true
